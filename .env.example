# ── د Windows لوکل کمپیوټر لپاره ──────────────────────────────────
# دا فایل کاپي کړه او نوم یې .env کړه:
#   copy .env.example .env
#
# ── Replit کې ──────────────────────────────────────────────────────
# Replit پخپله /api کاروي — دلته .env فایل پکار نه دی

# د Backend پته (د Windows لوکل لپاره)
VITE_API_BASE_URL=http://localhost:3001/api

# Firebase — اختیاري (یوازې د آنلاین ایمیل/خبرتیا لپاره)
# که خالي پریږدې، سیسټم د demo/offline حالت کې کار کوي
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
